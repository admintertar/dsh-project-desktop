{
  "name": "dsh-project-desktop",
  "version": "0.1.8",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "main": "src/app/main.mjs",
  "description": "Project Desktop shell built around an unmodified, pinned DSH Desktop stable runtime",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "setup:electron": "node scripts/setup-electron.mjs",
    "smoke:native": "node scripts/smoke-native.mjs",
    "smoke:profiles": "node scripts/smoke-profiles.mjs",
    "smoke:updates": "node scripts/smoke-updates.mjs",
    "smoke:updates:live": "node scripts/smoke-live-updates.mjs",
    "smoke:guide": "node scripts/smoke-guide.mjs",
    "smoke:guide:focused": "node scripts/smoke-guide.mjs --focused",
    "smoke:resources": "node scripts/smoke-resource-states.mjs",
    "smoke:lifecycle": "node scripts/smoke-lifecycle.mjs",
    "setup": "node scripts/setup.mjs",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:recovery": "node --test scripts/check-recovery.mjs",
    "test:safe-mode": "node --test scripts/check-safe-mode.mjs",
    "test:recovery:network": "node scripts/check-network-recovery.mjs",
    "package:mac": "yarn run build && node scripts/package-macos.mjs",
    "package:win": "yarn run build && node scripts/package-windows.mjs",
    "sign:mac": "node scripts/sign-macos.mjs",
    "smoke:host": "node scripts/smoke-host.mjs",
    "check": "yarn run verify:upstream && yarn run build && yarn run test && yarn run test:recovery && yarn run test:safe-mode && node scripts/check-project-files.mjs && yarn run smoke:host"
  },
  "dependencies": {
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@shikijs/langs": "4.3.1",
    "anser": "2.3.5",
    "esbuild": "0.25.10",
    "immer": "10.1.1",
    "katex": "0.16.47",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "shiki": "4.3.1",
    "zustand": "4.4.7"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    }
  }
}
