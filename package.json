{
  "name": "dsh-project-desktop",
  "version": "0.1.11",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "main": "src/app/main.mjs",
  "description": "Project Desktop shell using the pinned official DeepSeek Harness Desktop",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "smoke:native": "node scripts/smoke-official-shell.mjs",
    "smoke:guide": "node scripts/smoke-official-shell.mjs",
    "smoke:lifecycle": "node scripts/smoke-official-shell.mjs",
    "setup": "node scripts/setup.mjs",
    "verify:official-source": "node scripts/verify-official-source.mjs",
    "prepare:official-development": "node scripts/prepare-official-development.mjs",
    "prepare:official-package-set": "node scripts/prepare-official-package-set.mjs",
    "prepare:official-runtime": "node scripts/prepare-official-runtime.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "package:mac": "node scripts/official-release-pending.mjs",
    "package:win": "node scripts/official-release-pending.mjs",
    "check": "yarn run build && yarn run test && node scripts/check-project-files.mjs",
    "smoke:official-shell": "node scripts/smoke-official-shell.mjs",
    "smoke:official-account-sharing": "node scripts/smoke-official-shell.mjs --account-sharing",
    "smoke:official-close": "node scripts/smoke-official-shell.mjs --close"
  },
  "dependencies": {
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@shikijs/langs": "4.3.1",
    "anser": "2.3.5",
    "esbuild": "0.25.10",
    "immer": "10.1.1",
    "katex": "0.16.47",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "shiki": "4.3.1",
    "simple-icons": "16.31.0",
    "zustand": "4.4.7"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    }
  }
}
